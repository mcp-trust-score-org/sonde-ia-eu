{
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/d/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60"
        },
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/d/cartes/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/declencher",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/rappels?moment=matin",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/rappels?moment=midi",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/rappels?moment=soir",
      "schedule": "0 17 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/d/donnees/:fichier",
      "destination": "https://raw.githubusercontent.com/mcp-trust-score-org/sonde-ia-eu/main/iris/donnees/:fichier"
    },
    {
      "source": "/d/publies.json",
      "destination": "https://raw.githubusercontent.com/mcp-trust-score-org/sonde-ia-eu/main/iris/publies.json"
    },
    {
      "source": "/d/plus.json",
      "destination": "https://raw.githubusercontent.com/mcp-trust-score-org/sonde-ia-eu/main/iris/plus.json"
    },
    {
      "source": "/d/mercato.json",
      "destination": "https://raw.githubusercontent.com/mcp-trust-score-org/sonde-ia-eu/main/iris/mercato.json"
    },
    {
      "source": "/d/cartes/:fichier",
      "destination": "https://raw.githubusercontent.com/mcp-trust-score-org/sonde-ia-eu/main/iris/cartes/:fichier"
    },
    {
      "source": "/d/marches.json",
      "destination": "https://raw.githubusercontent.com/mcp-trust-score-org/sonde-ia-eu/main/public/marches.json"
    }
  ]
}
