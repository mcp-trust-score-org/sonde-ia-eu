{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Impact Iris — sortie de la sonde vers le média",
  "description": "Un impact = un événement rapproché des mesures d'un client. Produit par la sonde, relu par la rédaction avant publication.",
  "type": "object",
  "required": ["impact_id", "client_id", "evenement", "correlation", "statut_editorial", "regles_version"],
  "properties": {
    "impact_id": { "type": "string" },
    "article_id": { "type": ["string", "null"], "description": "Identifiant de l'article du média, ex. 'clim'" },
    "client_id": { "type": "string" },
    "regles_version": { "type": "string", "description": "Version de correlation-rules.yaml utilisée" },

    "evenement": {
      "type": "object",
      "required": ["type", "fournisseur", "debut", "sources"],
      "properties": {
        "type": { "enum": ["refroidissement", "energie", "materiel", "reseau", "certificat", "logiciel", "maintenance", "cyberattaque", "autre"] },
        "fournisseur": { "type": "string" },
        "region": { "type": ["string", "null"], "description": "null ou 'global' si toutes les régions" },
        "debut": { "type": "string", "format": "date-time" },
        "fin": { "type": ["string", "null"], "format": "date-time" },
        "sources": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "url"],
            "properties": {
              "type": { "enum": ["statut_fournisseur", "rapport_incident", "presse", "reseaux_sociaux", "signalement_utilisateur"] },
              "url": { "type": "string", "format": "uri" },
              "titre": { "type": "string" },
              "date": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },

    "correlation": {
      "type": "object",
      "required": ["lieu", "moment", "symptome", "officiel", "multi_points", "niveau"],
      "properties": {
        "lieu": { "type": "boolean" },
        "moment": { "type": "boolean" },
        "symptome": { "type": "boolean" },
        "officiel": { "type": "boolean" },
        "multi_points": { "type": "boolean" },
        "niveau": { "enum": ["confirme", "probable", "possible", "non_concerne", "hors_perimetre"], "description": "Tag de relecture : jamais affiché sur le site, sert à la rédaction pour décider de publier" },
        "texte_propose": { "type": "string", "description": "Gabarit rempli selon le niveau (règle R6)" }
      }
    },

    "mesures": {
      "type": ["object", "null"],
      "properties": {
        "symptome": { "enum": ["indisponibilite", "lenteur", "erreurs"] },
        "debut_anomalie": { "type": "string", "format": "date-time" },
        "fin_anomalie": { "type": ["string", "null"], "format": "date-time" },
        "duree_secondes": { "type": "integer" },
        "points_de_mesure": { "type": "array", "items": { "type": "string" } },
        "preuves": { "type": "array", "items": { "type": "string" }, "description": "Identifiants des mesures horodatées" }
      }
    },

    "services_touches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nom": { "type": "string" },
          "criticite": { "enum": ["critique", "importante", "standard"] }
        }
      }
    },

    "avoir_estime": {
      "type": ["object", "null"],
      "description": "Seulement si niveau = confirme ou probable (règle R7)",
      "properties": {
        "montant": { "type": "number" },
        "devise": { "type": "string", "default": "EUR" },
        "sla_contractuel": { "type": "number" },
        "disponibilite_mesuree": { "type": "number" }
      }
    },

    "statut_editorial": { "enum": ["brouillon_auto", "a_relire", "valide", "publie", "rejete"] },
    "valide_par": { "type": ["string", "null"] },
    "valide_le": { "type": ["string", "null"], "format": "date-time" }
  }
}
